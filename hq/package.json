{
  "name": "@sideagent/hq",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ALLOW_SAME_OWNER=${ALLOW_SAME_OWNER:-true} FIRESTORE_EMULATOR_HOST=${FIRESTORE_EMULATOR_HOST:-127.0.0.1:8180} FIREBASE_AUTH_EMULATOR_HOST=${FIREBASE_AUTH_EMULATOR_HOST:-127.0.0.1:9099} tsx watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "start:budget-guard": "node --import tsx src/budget-guard.ts",
    "seed": "FIRESTORE_EMULATOR_HOST=${FIRESTORE_EMULATOR_HOST:-127.0.0.1:8180} tsx scripts/seed.ts",
    "seed:house": "tsx scripts/seed-house.ts",
    "eval:screening": "tsx scripts/eval-screening.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google-cloud/dlp": "^7.2.0",
    "@google-cloud/kms": "^6.3.0",
    "@google-cloud/run": "^4.2.0",
    "@google-cloud/storage": "^8.4.0",
    "@google-cloud/tasks": "^7.3.0",
    "@google/genai": "^2.29.1",
    "@hono/node-server": "^2.1.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@sideagent/protocol": "workspace:*",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.0",
    "hono": "^4.13.13",
    "tsx": "^4.23.15",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.0.0"
  }
}
